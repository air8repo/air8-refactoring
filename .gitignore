# Debug scripts
debug_*.py
# Don't ignore auto restart agent script
!auto_restart_agent.py
# Ignore root-level test files but keep backend/tests/
test_*.py
!backend/tests/test_*.py

# Temporary files
*.tmp
*.temp

# Chinese documentation
*.txt
# Don't ignore important txt files
!requirements.txt

# Batch files
*.bat
*.ps1

# Output files
*.output.txt
*.csv

# Other
*.png
# Don't ignore important markdown files
!project_rules.md
*.cfg

# Git worktrees (local scratch, not part of history)
.worktrees/

# Subagent-driven-development scratch workspace (ledger, briefs, review packages)
.superpowers/